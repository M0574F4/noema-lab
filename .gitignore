# Python caches and bytecode
__pycache__/
*.py[cod]
*$py.class

# Python build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# Native extension build outputs
*.so
*.pyd
*.dylib
*.dll
*.o
*.obj

# Virtual environments
.venv*/
venv/
env/
.env
.env.*

# Test, lint, type-check, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Noema local workspace: datasets, checkpoints, runs, exports, and caches
.noema/
.[s]emcom/
datasets/
checkpoints/
runs/
artifacts/
upstreams/

