*.ckpt
*.pth
*.pth.tar
*.pt
*.pt2
*.safetensors
*.onnx
*.engine
*.plan
*.npy
*.npz

# Local screen recordings and edits. Published video assets require an explicit reviewed add.
recordings/
*.mkv
*.mp4
*.mov
*.avi
*.webm

# Generated documentation
docs/*.pdf
docs/_build/

# Node/frontend local artifacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor, OS, and local tool state
.DS_Store
Thumbs.db
.idea/
.vscode/
.codex/
.agents/

# Logs and temporary files
*.log
*.tmp
*.temp
tmp/
temp/

# README Quick Start output
/noema-quickstart.yaml
