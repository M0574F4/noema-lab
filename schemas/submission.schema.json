{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://noema-lab.dev/schemas/submission.schema.json",
  "title": "Noema benchmark submission",
  "type": "object",
  "required": ["schema_version", "method", "benchmark", "runtime", "reproducibility", "result_bundle", "comparison_division"],
  "properties": {
    "schema_version": {"const": 1},
    "comparison_division": {"enum": ["closed", "open"]},
    "result_bundle": {"type": "string"},
    "method": {
      "type": "object",
      "required": ["name", "authors"],
      "properties": {
        "name": {"type": "string"},
        "authors": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "description": {"type": "string"}
      },
      "additionalProperties": true
    },
    "benchmark": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "adapter": {
      "type": "object",
      "properties": {
        "manifest": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": "string"}
      },
      "additionalProperties": true
    },
    "runtime": {
      "type": "object",
      "required": ["hardware", "software"],
      "properties": {
        "hardware": {"type": "string"},
        "software": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "reproducibility": {
      "type": "object",
      "required": ["recipe_sha256", "seed_policy", "seeds"],
      "properties": {
        "recipe_sha256": {"type": "string"},
        "recipe_sha256s": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "seed_policy": {"type": "string"},
        "seed_policy_sha256s": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "uniqueItems": true
        },
        "seeds": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0},
          "uniqueItems": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
