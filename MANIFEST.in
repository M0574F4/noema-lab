prune demo_trainings/csi_feedback_autoencoder/.noema
global-exclude *.py[cod]
global-exclude __pycache__
recursive-include schemas *.json

# Defense in depth: local data, model artifacts, and build products are never package payload.
prune .noema
prune differentiable_exports
prune trained_artifacts
prune training_exports
